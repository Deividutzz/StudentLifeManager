<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="BaseLoginPage" TargetType="Page">
        
        <Setter Property="Background" Value="{StaticResource RetroDarkBackground}" />
        <Setter Property="Foreground" Value="{StaticResource RetroTextLight}"/>
        <Setter Property="FontFamily" Value="{StaticResource RetroBodyFont}" />
        <Setter Property="FontSize" Value="20"/>
        
    </Style>
    
    
    <Style x:Key="BaseRegisterPage" TargetType="Page">
        
        <Setter Property="Background" Value="{StaticResource RetroRegisterBackground}" />
        <Setter Property="FontFamily" Value="{StaticResource RetroBodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource RetroTextLight}" />
        <Setter Property="FontSize" Value="20"/>
        
    </Style>
    
    <Style x:Key="BaseMainPage" TargetType="Page">

        <!-- Main dashboard background -->
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F0A1E" Offset="0"/>
                    <GradientStop Color="#140D2B" Offset="0.45"/>
                    <GradientStop Color="#1A1333" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <!-- Default page text style -->
        <Setter Property="Foreground" Value="{StaticResource RetroTextLight}"/>
        <Setter Property="FontFamily" Value="{StaticResource RetroBodyFont}"/>
        <Setter Property="FontSize" Value="18"/>

    </Style>
    
</ResourceDictionary>
