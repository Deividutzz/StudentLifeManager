<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main heading: Login / Register title -->
    <Style x:Key="RetroHeadingText" TargetType="TextBlock">
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource RetroLightPurple}"/>
        <Setter Property="FontFamily" Value="{StaticResource RetroHeadingFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,8,0,16"/>
        <Setter Property="Background" Value="Transparent"/>

        <!-- Soft formal purple glow -->
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Color="#C4B5FD"
                                  Opacity="0.28"/>
            </Setter.Value>
        </Setter>
        
    </Style>

    <!-- Normal labels: Username, Password, Email etc. -->
    <Style x:Key="RetroLabelText" TargetType="TextBlock">
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource RetroTextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource RetroBodyFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        
    </Style>

    <!-- Small helper text: hints, extra info, switch login/register text -->
    <Style x:Key="RetroSmallText" TargetType="TextBlock">
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource RetroTextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource RetroBodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
        
    </Style>

    <!-- Error text: validation messages -->
    <Style x:Key="RetroErrorText" TargetType="TextBlock">
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource RetroError}"/>
        <Setter Property="FontFamily" Value="{StaticResource RetroBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,6,0,2"/>
        
    </Style>

</ResourceDictionary>