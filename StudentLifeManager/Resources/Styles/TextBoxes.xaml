<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="RetroLoginTextBox" TargetType="TextBox">

        <!-- Main look -->
        <Setter Property="Background" Value="{StaticResource RetroPanelBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource RetroTextLight}"/>
        <Setter Property="CaretBrush" Value="{StaticResource RetroLightPurple}"/>

        <!-- Selection colors when text is selected -->
        <Setter Property="SelectionBrush" Value="{StaticResource RetroPrimaryPurple}"/>
        <Setter Property="SelectionTextBrush" Value="{StaticResource RetroTextLight}"/>

        <!-- Border -->
        <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBright}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>

        <!-- Size / spacing -->
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="MinWidth" Value="130"/>

        <!-- Font / layout -->
        <Setter Property="FontFamily" Value="{StaticResource RetroBodyFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- Removes default blue focus rectangle -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover: subtle border change only -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource RetroLightPurple}"/>
                        </Trigger>

                        <!-- Focused: clean purple glow -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource RetroLightPurple}"/>

                            <Setter TargetName="TextBoxBorder"
                                    Property="Background"
                                    Value="{StaticResource RetroSurfaceElevated}"/>

                            <Setter TargetName="TextBoxBorder"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Color="#C4B5FD"
                                                      Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
    
</ResourceDictionary>