<Page x:Class="StudentLifeManager.classes.Views.Pages.Login.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
      mc:Ignorable="d"
      Height="450" Width="800">
      
      <Grid VerticalAlignment = "Center" HorizontalAlignment="Center">
            
            <Border Width="800" Height="400">
            
                  <StackPanel>
                  
                        <TextBlock Text="SIGN IN" HorizontalAlignment="Center" FontSize="24" VerticalAlignment="Top" />
                        
                        <TextBlock Text="&#10;Create a username:" FontSize="16"/>
                        <StackPanel Orientation="Horizontal">
                              <TextBox Name="UsernameTb" HorizontalAlignment="Left" MinWidth="100" KeyDown="EnterInput"/>
                              <TextBlock Name="UsernameErr" Foreground="Red" FontSize="16" Visibility="Collapsed"/>
                        </StackPanel>
                        
                        <TextBlock Text="Create a password:" FontSize="16"/>
                        <StackPanel Orientation="Horizontal">
                              <TextBox Name="PasswordTb" HorizontalAlignment="Left" MinWidth="100" KeyDown="EnterInput"/>
                              <TextBlock Name="PasswordErr" Foreground="Red" FontSize="16" Visibility="Collapsed"/>
                        </StackPanel>
                        
                        <Button Cursor="Hand"
                                HorizontalAlignment="Left"
                                Content="Log in"
                                Click="GoToLogin"
                                MinWidth="125"/>
                        
                        <Button Cursor="Hand"
                                HorizontalAlignment="Left"
                                Content="Register now"
                                Click="Register"
                                MinWidth="125"/>
                        
                        <TextBlock Name="Confirmation" Foreground="ForestGreen" FontSize="16" Visibility="Collapsed" />
                  
                  </StackPanel>
              
            </Border>
          
      </Grid>
      
</Page>