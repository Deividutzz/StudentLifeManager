<Page x:Class="StudentLifeManager.classes.Views.Pages.Login.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      
      Style="{StaticResource BaseRegisterPage}"
      
      mc:Ignorable="d">
      
    <Page.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource LoginCheckBox}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource RetroLoginTextBox}" />
        <Style TargetType="Button" BasedOn="{StaticResource PrimaryLoginButton}" />
    </Page.Resources>
      
    <Grid Margin="20">
            
        <Border Padding="40"
                Width="960"
                Height="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <Grid>

                <!-- Page title -->
                <TextBlock Text="Create account"
                           Style="{StaticResource RetroHeadingText}"
                           FontSize="32"
                           VerticalAlignment="Top"
                           Margin="0,25,0,0"/>

                <!-- Register form -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                              
                    <TextBlock Text="Create an username:"
                               Style="{StaticResource RetroLabelText}"/>
                        
                    <TextBox Name="UsernameTb"
                             KeyDown="EnterInput"
                             TextChanged="OnTextChanged"/>

                    <TextBlock Name="UsernameErr"
                               Style="{StaticResource RetroErrorText}"
                               Visibility="Hidden"/>
                              
                    <TextBlock Text="Create a password:"
                               Style="{StaticResource RetroLabelText}"
                               Margin="0,10,0,3"/>
                        
                    <TextBox Name="PasswordTb"
                             KeyDown="EnterInput"
                             TextChanged="OnTextChanged"
                             PreviewTextInput="PasswordPreviewTextInput"
                             PreviewKeyDown="PasswordPreviewKeyDown"/>
                              
                    <CheckBox Content="View password"
                              Checked="Checked"
                              Unchecked="Unchecked"/>

                    <TextBlock Name="PasswordErr"
                               Style="{StaticResource RetroErrorText}"
                               Visibility="Hidden"/>
                              
                </StackPanel>
                        
                <!-- Bottom actions -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,20">
                              
                    <Button Content="Register now"
                            Click="Register"
                            MinWidth="130"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0">

                        <TextBlock Text="Already have an account? "
                                   Style="{StaticResource RetroLabelText}"
                                   VerticalAlignment="Center"/>

                        <Button Content="Log in"
                                Click="GoToLogin"
                                Padding="0"
                                FontSize="16"/>

                    </StackPanel>

                    <TextBlock Name="Confirmation"
                               Foreground="{StaticResource RetroSuccess}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Visibility="Hidden"/>
                              
                </StackPanel>
                        
            </Grid>
              
        </Border>
          
    </Grid>
      
</Page>