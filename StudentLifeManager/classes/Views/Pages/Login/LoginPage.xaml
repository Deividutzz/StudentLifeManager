<Page x:Class="StudentLifeManager.classes.Views.Pages.Login.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        Style="{StaticResource LoginPageStyle}"

        mc:Ignorable="d">
    
    <Page.Resources>
        
        <Style TargetType="TextBlock" BasedOn="{StaticResource LoginTextBlock}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource LoginTextBox}" />
        <Style TargetType="Button" BasedOn="{StaticResource LoginButton}" />
        
    </Page.Resources>
    
    <Grid Margin="20">
          
        <Border Padding="60" Width="1300" Height="607">
          
            <Grid>
              
                <TextBlock Text="Log in:" VerticalAlignment="Top" FontSize="48"/>

                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Insert your username:" />
                    <TextBox Name = "Username" KeyDown="EnterInput" MinWidth="100" />

                    <TextBlock Text="Insert the password:" />
                    <TextBox Name = "Password" KeyDown="EnterInput" MinWidth="125" />

                </StackPanel>
                
                <StackPanel VerticalAlignment="Bottom">
                    
                    <Button Content="Log in" Click="Validate" MinWidth="130" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >

                        <TextBlock Text="Don't have an account? " />
                        <Button Content="Sign in"
                                Click="GoRegister"
                                Background="Transparent"
                                BorderBrush="Transparent" />

                    </StackPanel>

                    <TextBlock Name="LoginErr"
                               Foreground="Red"
                               Visibility="Hidden"/>

                </StackPanel>
                
            </Grid>
          
        </Border>
        
        <Button Content="Delete all users"
            FontSize="16"
            Foreground="Red"
            Background="Black"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="DeleteUsers" />
          
    </Grid>
    
</Page>