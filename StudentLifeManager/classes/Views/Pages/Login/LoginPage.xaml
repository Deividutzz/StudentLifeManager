<Page x:Class="StudentLifeManager.classes.Views.Pages.Login.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        Style="{StaticResource BaseLoginPage}"

        mc:Ignorable="d">
    
    <Page.Resources>
        
        <Style TargetType="CheckBox" BasedOn="{StaticResource LoginCheckBox}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource RetroLabelText}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource RetroLoginTextBox}" />
        <Style TargetType="Button" BasedOn="{StaticResource PrimaryLoginButton}" />
        
    </Page.Resources>
    
    <Grid Margin="20" >
          
        <Border  Padding="40" Width="960" Height="480">
          
            <Grid Background="Transparent">
              
                <TextBlock Text="Sign in" Padding="0,40,0,0"
                           Style="{StaticResource RetroHeadingText}"
                           VerticalAlignment="Top" FontSize="32"/>

                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Insert your username:" />
                    <TextBox Name = "Username" KeyDown="EnterInput" />

                    <TextBlock Text="Insert the password:" />
                    
                    <TextBox Name = "Password" KeyDown="EnterInput" 
                             PreviewTextInput="PasswordPreviewTextInput"
                             PreviewKeyDown="PasswordPreviewKeyDown" />
                    
                    <CheckBox Content="View password" Checked="Checked" Unchecked="Unchecked"/>

                </StackPanel>
                
                <StackPanel VerticalAlignment="Bottom">
                    
                    <Button Content="Log in" Click="Validate" Padding="0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >

                        <TextBlock Text="Don't have an account? " />
                        <Button Content="Register"
                                Click="GoRegister"
                                Padding="0"
                                FontSize="16"/>

                    </StackPanel>

                    <TextBlock Name="LoginErr"
                               Style="{StaticResource RetroErrorText}"
                               Visibility="Hidden"/>

                </StackPanel>
                
            </Grid>
          
        </Border>
        
        
        <Button Content="Delete all users"
            FontSize="11"
            Foreground="Red"
            Background="Black"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="DeleteUsers" />
        <Button Content="cheating" Click="Cheats" HorizontalAlignment="Left"
                VerticalAlignment="Bottom"/>
          
    </Grid>
    
</Page>
