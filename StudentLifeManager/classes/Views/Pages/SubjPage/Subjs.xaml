<Page x:Class="StudentLifeManager.classes.Views.Pages.SubjPage.Subjs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Style="{StaticResource BaseMainPage}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="160"
                    Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="GoHome"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Image Source="/Resources/Assets/Icons/HomePage.png"
                           Width="22"
                           Height="22"
                           Margin="0,0,8,0"/>

                    <TextBlock Text="Home"
                               Foreground="{StaticResource RetroTextLight}"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <!-- Page title, centered -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">

                <TextBlock Text="Subjects"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RetroLightPurple}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Manage your school subjects"
                           FontSize="15"
                           Foreground="{StaticResource RetroTextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>
        
        <Border Grid.Row="1"
                Width="720"
                MinHeight="520"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource RetroPanelBackground}"
                BorderBrush="{StaticResource RetroBorderBright}"
                BorderThickness="2"
                CornerRadius="16">

            <Grid>

                <Grid.RowDefinitions>
                    <!-- Add subject form -->
                    <RowDefinition Height="Auto"/>

                    <!-- Subjects list -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Add subject section -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">

                    <TextBlock Text="Please insert a subject"
                               FontSize="22"
                               Foreground="{StaticResource RetroTextLight}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBox Text="{Binding NewSubjectName, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="EnterInput"
                             Width="260"
                             Margin="0,0,0,10"/>

                    <Button Content="Add Subject"
                            Width="150"
                            Click="AddSubject"
                            Margin="0,0,0,10"/>

                    <TextBlock Name="SubjectsError"
                               Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource RetroError}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               Visibility="Collapsed"/>

                </StackPanel>
                
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Subjects}"
                         Width="620"
                         Height="300"
                         HorizontalAlignment="Center">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Grid Margin="5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         IsReadOnly="{Binding IsEditing}"
                                         Text="{Binding Name}"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource RetroTextLight}"
                                         MinWidth="180"/>

                                <Button Content="Edit"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        MinWidth="70"
                                        Click="EditSubject"/>

                                <Button Content="Save"
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        MinWidth="70"
                                        Click="SaveSubject"/>

                                <Button Content="Remove"
                                        Grid.Column="3"
                                        Margin="10,0,0,0"
                                        MinWidth="90"
                                        Click="RemoveSubject"/>

                            </Grid>

                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>

        </Border>
        
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,20,0,0">

            <Button Content="Log out"
                    Width="140"
                    Margin="0,0,10,0"/>

            <Button Content="Delete table"
                    Width="140"
                    Click="DeleteData"/>

        </StackPanel>

    </Grid>

</Page>