<Page x:Class="StudentLifeManager.classes.Views.Pages.MainPage.MainPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        mc:Ignorable="d"
        Title="MainPage" Width="800" Height="500">
    
    <StackPanel Margin="10" HorizontalAlignment="Center" >
        <TextBlock Name="WelcomeTb" FontSize="28" HorizontalAlignment="Center" /> 
        
        <TextBlock Text="Please insert a subject" FontSize="24" HorizontalAlignment="Center" />
        
        <TextBox Text="{Binding NewSubjectName, UpdateSourceTrigger=PropertyChanged}" 
                 KeyDown="EnterInput" Width="200" Margin="0,0,0,10"/>
        
        <Button Content="Add Subject" Width="100" Click="AddSubject" Margin="0,0,0,10" />
        
        <TextBlock Name="SubjectsError"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red" 
                   Margin="0,0,0,10"
                   Visibility="Collapsed" />
        
        <ListBox ItemsSource="{Binding Subjects}" Height="200" Width="300">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox IsReadOnly="{Binding IsEditing}"
                                 Text="{Binding Name}"
                                 VerticalAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent" />
                        
                        <Button Content="Edit Subject"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Click="EditSubject"/>
                        
                        <Button Content="Save"
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                Click="SaveSubject"/>
                        
                        <Button Content="Remove Subject"
                                Grid.Column="3"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Click="RemoveSubject"/>
                        
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Button Cursor="Hand" Content="Log out" Click="LogOut" HorizontalAlignment="Center" MinWidth="100" />
        <Button Content="Delete table" Click="DeleteData"/>
        
    </StackPanel>
</Page>
