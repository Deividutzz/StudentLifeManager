<Page x:Class="StudentLifeManager.classes.Views.Pages.MainPage.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      
      mc:Ignorable="d"
      Title="MainPage"
      Style="{StaticResource BaseMainPage}">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0">

            <TextBlock Name="WelcomeTb"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource RetroTextLight}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <TextBlock Text="Choose where you want to go next"
                       FontSize="15"
                       Foreground="{StaticResource RetroTextMuted}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>

        </StackPanel>
        
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <WrapPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="1000">

                <Button Style="{StaticResource DashboardCardButton}"
                        Click="GoToSubjects">

                    <Grid>

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Subjects"
                                       Style="{StaticResource DashboardCardTitle}"/>

                            <TextBlock Text="Manage your school subjects, edit them, and organize your study life."
                                       Style="{StaticResource DashboardCardDescription}"/>
                        </StackPanel>

                        <TextBlock Text="Open →"
                                   Style="{StaticResource DashboardCardTag}"/>

                    </Grid>

                </Button>
                
                <Button Style="{StaticResource DashboardCardButton}"
                        IsEnabled="False">

                    <Grid>

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="To-do"
                                       Style="{StaticResource DashboardCardTitle}"/>

                            <TextBlock Text="Track homework, personal tasks, and important deadlines."
                                       Style="{StaticResource DashboardCardDescription}"/>
                        </StackPanel>

                        <TextBlock Text="Coming soon"
                                   Style="{StaticResource DashboardCardTag}"/>

                    </Grid>

                </Button>
                
                <Button Style="{StaticResource DashboardCardButton}"
                        IsEnabled="False">

                    <Grid>

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Calendar"
                                       Style="{StaticResource DashboardCardTitle}"/>

                            <TextBlock Text="Plan classes, exams, homework and study sessions."
                                       Style="{StaticResource DashboardCardDescription}"/>
                        </StackPanel>

                        <TextBlock Text="Coming soon"
                                   Style="{StaticResource DashboardCardTag}"/>

                    </Grid>

                </Button>

            </WrapPanel>

        </Grid>
        
        <Button Grid.Row="2"
                Content="Log out"
                Click="LogOut"
                VerticalAlignment="Bottom"
                MinWidth="120"
                Margin="0,20,0,10"
                Style="{StaticResource RetroButton}"/>

    </Grid>

</Page>